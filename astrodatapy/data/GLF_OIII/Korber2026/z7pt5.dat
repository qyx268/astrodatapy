39.75  -1.24  0.32   # N=23.37 <C>=0.41  S/N=3.07
40.25  -1.65  0.20   # N=26.98 <C>=0.47  S/N=4.85
40.75  -1.90  0.19   # N=25.24 <C>=0.51  S/N=5.16
